+    0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,  /* '|' */
+    0x00, 0x00, 0x00, 0x30, 0x08, 0x08, 0x10, 0x10,
+    0x08, 0x04, 0x08, 0x10, 0x10, 0x08, 0x08, 0x30,  /* '}' */
+    0x00, 0x00, 0x00, 0x31, 0x49, 0x46, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  /* '~' */
+};
+
+/* All zero, so no framebuffer, until fb_init() accepts one. */
+static struct {
+    u32 base;
+    u32 width;
+    u32 height;
+    u32 stride;
+    u32 white;
+    u32 scale;
+    u32 x;
+    u32 y;
+} fb;
+
+static u32 *fb_line(u32 y)
+{
+    return _p(fb.base + y * fb.stride);
+}
+
+static void fb_clear(u32 y, u32 lines)
+{
+    u32 *p;
+    u32 i;
+
+    for ( ; lines && y < fb.height; y++, lines-- )
+    {
+        p = fb_line(y);
+        for ( i = 0; i < fb.width; i++ )
+            p[i] = 0;
+    }
+}
+
+/* Starts a new text line and clears the one after it, which marks the end. */
+static void fb_newline(void)
+{
+    u32 line = FONT_HEIGHT * fb.scale;
+
+    fb.x = 0;
+    fb.y += line;
+    if ( fb.y + line > fb.height )
+        fb.y = 0;
+    fb_clear(fb.y, 2 * line);
+}
+
+static void fb_draw(u8 c)
+{
+    const u8 *glyph;
+    volatile u32 *p;
+    u32 row, col;
+    u8 bits;
+
+    if ( c < FONT_FIRST || c > FONT_LAST )
+        c = '?';
+    glyph = &font[(c - FONT_FIRST) * FONT_HEIGHT];
+
+    if ( fb.x + FONT_WIDTH * fb.scale > fb.width )
+        fb_newline();
+
+    for ( row = 0; row < FONT_HEIGHT * fb.scale; row++ )
+    {
+        p = fb_line(fb.y + row) + fb.x;
+        bits = glyph[row / fb.scale];
+        for ( col = 0; col < FONT_WIDTH * fb.scale; col++ )
+            p[col] = (bits & (0x80 >> (col / fb.scale))) ? fb.white : 0;
+    }
+
+    fb.x += FONT_WIDTH * fb.scale;
+}
+
+void fb_putc(char c)
+{
+    if ( fb.base == 0 )
+        return;
+
+    if ( c == '\n' )
+        fb_newline();
+    else if ( c == '\r' )
+        fb.x = 0;
+    else
+        fb_draw(c);
+}
+
+void fb_init(void)
+{
+    struct slr_entry_debug_fb *e;
+    u64 slb = _u(_start);
+    u64 end;
+
+    e = next_entry_with_tag(NULL, SLR_ENTRY_DEBUG_FB);
+    if ( e == NULL
+         || e->hdr.size != sizeof(*e)
+         || end_of_slrt() < _p(&e[1])
+         || e->base == 0 )
+        return;
+
+    end = e->base + e->size;
+
+    if ( e->width == 0 || e->width > 0x4000
+         || e->height == 0 || e->height > 0x4000
+         || e->stride < e->width * 4
+         || (u64)e->stride * e->height > e->size
+         || end < e->base )
+    {
+        print("Framebuffer: bad geometry, not used\n");
+        return;
+    }
+
+    if ( end > 0x100000000ULL )
+    {
+        print("Framebuffer: above 4 GiB, not used\n");
+        return;
+    }
+
+    if ( e->base < slb + SLB_SIZE && end > slb )
+    {
+        print("Framebuffer: overlaps the SKL, not used\n");
+        return;
+    }
+
+    fb.width = e->width;
+    fb.height = e->height;
+    fb.stride = e->stride;
+    fb.white = e->white;
+    fb.scale = e->width / 1280 ? : 1;
+    fb.y = e->next_y < e->height ? e->next_y : 0;
+    fb.x = 0;
+    fb.base = e->base;
+
+    print("Framebuffer: SKL prints here too, at ");
+    print_p(_p(fb.base));
+    print("\n");
+}
+

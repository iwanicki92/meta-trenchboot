+/*
+ * One command without arguments, its status and c2pmsg_93 to _95 as the
+ * PSP left them printed, and true on DRTM_NO_ERROR.
+ */
+static bool drtm_command_no_args(const char *name, u32 cmd)
+{
+    u32 status = 0;
+
+    if (!(*g_psp_drtm.c2pmsg_72 & DRTM_MBOX_READY_MASK)) {
+        print("DRTM: ");
+        print(name);
+        print(": PSP not ready\n");
+        return false;
+    }
+
+    *g_psp_drtm.c2pmsg_93 = 0;
+    *g_psp_drtm.c2pmsg_94 = 0;
+    *g_psp_drtm.c2pmsg_95 = 0;
+    *g_psp_drtm.c2pmsg_72 = (cmd << DRTM_MBOX_CMD_SHIFT);
+    if (!drtm_wait_for_psp_ready(&status)) {
+        print("DRTM: ");
+        print(name);
+        print(": command failed to complete\n");
+        return false;
+    }
+
+    print("DRTM: ");
+    print(name);
+    print(": status ");
+    drtm_print_status(status);
+    print(", c2pmsg_93 = ");
+    print_u64(*g_psp_drtm.c2pmsg_93);
+    print(", c2pmsg_94 = ");
+    print_u64(*g_psp_drtm.c2pmsg_94);
+    print(", c2pmsg_95 = ");
+    print_u64(*g_psp_drtm.c2pmsg_95);
+    print("\n");
+
+    return status == 0;
+}
+
+/*
+ * The log of the PSP's extends, as DRTM_CMD_GET_TCG_LOGS names it: the
+ * size in c2pmsg_93, the address in _94 and _95, as
+ * DRTM_CMD_EXTEND_OSSL_DIGEST takes one. The guide places
+ * DRTM_CMD_ALLOCATE_SHARED_MEMORY before the command, so a failed first
+ * attempt is retried once after it.
+ */
+bool drtm_get_tcg_logs(u64 *addr, u64 *size)
+{
+    print("DRTM: drtm_get_tcg_logs: Entering\n");
+
+    if (!drtm_command_no_args("drtm_get_tcg_logs", DRTM_CMD_GET_TCG_LOGS)) {
+        print("DRTM: drtm_get_tcg_logs: retrying after "
+              "DRTM_CMD_ALLOCATE_SHARED_MEMORY\n");
+        drtm_command_no_args("drtm_allocate_shared_memory",
+                             DRTM_CMD_ALLOCATE_SHARED_MEMORY);
+        if (!drtm_command_no_args("drtm_get_tcg_logs",
+                                  DRTM_CMD_GET_TCG_LOGS)) {
+            return false;
+        }
+    }
+
+    *size = *g_psp_drtm.c2pmsg_93;
+    *addr = *g_psp_drtm.c2pmsg_94 | ((u64)*g_psp_drtm.c2pmsg_95 << 32);
+
+    return true;
+}
+
 #endif /* AMDSL */
diff --git a/test-event_log.c b/test-event_log.c
new file mode 100644
index 0000000..daabb32
--- /dev/null
+++ b/test-event_log.c
@@ -0,0 +1,504 @@
+/*
+ * A hosted test of the TPM 2.0 event log: the header and records follow
+ * the TPM's banks, with the placeholder where the SKL has no digest, and
+ * event_log_append_tcg2() rewrites the PSP DRTM service's records to
+ * them, refusing a log that does not fit or parse.
+ */
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <stdarg.h>
+
+/* The host's C runtime owns _start, so the SKL's symbols go by other names */
+#define _start skl_start
+#define _end_of_measured skl_end_of_measured
+
+#include "sha1sum.c"
+#include "sha256.c"
+#include "event_log.c"
+
+#ifdef DEBUG
+void print(const char *unused) { }
+void print_u64(u64 unused) { }
+#endif
+
+/* An SLB-sized image whose first 16 bytes are what SKINIT measured */
+const char skl_start[SLB_SIZE] = "SKINIT measured";
+__asm__(".globl skl_end_of_measured\n.set skl_end_of_measured, skl_start + 16");
+
+/*
+ * The SLRT the SKL reads its log region from, one log info entry, under
+ * the symbol slrt.h declares.
+ */
+struct {
+    struct slr_table t;
+    struct slr_entry_log_info log;
+    struct slr_entry_hdr end;
+} __packed slrt __asm__("bootloader_data");
+
+static u8 log_region[4096];
+
+/* What the TPM answers for its banks */
+static u16 tpm_algs[MAX_BANKS];
+static u32 tpm_nalgs;
+static int tpm_banks_rc;
+
+int tpm_get_pcr_banks(struct tpm *t, u16 *algs, u32 *count)
+{
+    if ( tpm_banks_rc )
+        return tpm_banks_rc;
+    memcpy(algs, tpm_algs, tpm_nalgs * sizeof(u16));
+    *count = tpm_nalgs;
+    return 0;
+}
+
+static void tpm_has(u32 n, ...)
+{
+    va_list ap;
+    u32 i;
+
+    va_start(ap, n);
+    for ( i = 0; i < n; i++ )
+        tpm_algs[i] = va_arg(ap, int);
+    va_end(ap);
+    tpm_nalgs = n;
+    tpm_banks_rc = 0;
+}
+
+/* The extends made: (pcr, alg, whether the placeholder) */
+static struct {
+    u32 pcr;
+    u16 alg;
+    bool placeholder;
+} extends[32];
+static unsigned nextends;
+
+static bool is_placeholder(const u8 *digest, u32 size)
+{
+    u32 i;
+
+    if ( digest[0] != 1 )
+        return false;
+    for ( i = 1; i < size; i++ )
+        if ( digest[i] != 0 )
+            return false;
+    return true;
+}
+
+int tpm_extend_pcr(struct tpm *t, u32 pcr, u16 algo, u8 *digest)
+{
+    if ( nextends < 32 )
+    {
+        extends[nextends].pcr = pcr;
+        extends[nextends].alg = algo;
+        extends[nextends].placeholder = is_placeholder(digest, digest_size(algo));
+    }
+    nextends++;
+    return 0;
+}
+
+/* Little endian writes into a buffer being built */
+static u8 *put32(u8 *p, u32 v) { memcpy(p, &v, 4); return p + 4; }
+static u8 *put16(u8 *p, u16 v) { memcpy(p, &v, 2); return p + 2; }
+
+/* A TCG_PCR_EVENT2 with one digest of @fill bytes and @len bytes of data */
+static u8 *put_record(u8 *p, u32 pcr, u32 type, u16 alg, u32 dsize, u8 fill,
+                      u32 len)
+{
+    p = put32(p, pcr);
+    p = put32(p, type);
+    p = put32(p, 1);
+    p = put16(p, alg);
+    memset(p, fill, dsize);
+    p += dsize;
+    p = put32(p, len);
+    memset(p, 0xee, len);
+    return p + len;
+}
+
+/* The same with a SHA-1 digest before the SHA-256 one */
+static u8 *put_record2(u8 *p, u32 pcr, u32 type, u8 fill, u32 len)
+{
+    p = put32(p, pcr);
+    p = put32(p, type);
+    p = put32(p, 2);
+    p = put16(p, TPM_ALG_SHA1);
+    memset(p, fill, 20);
+    p += 20;
+    p = put16(p, TPM_ALG_SHA256);
+    memset(p, fill, 32);
+    p += 32;
+    p = put32(p, len);
+    memset(p, 0xee, len);
+    return p + len;
+}
+
+enum { PLAIN, WITH_SHA384, WITH_SHA1 };
+
+/*
+ * The PSP's log: the Spec ID header then the records of a launch. Its
+ * header declares SHA-256, and SHA-384 or SHA-1 too when asked, with one
+ * record carrying the extra bank last.
+ */
+static u32 psp_log(u8 *buf, int extra)
+{
+    u8 *p = buf;
+
+    p = put32(p, 0);            /* pcr */
+    p = put32(p, EV_NO_ACTION); /* type */
+    memset(p, 0, 20);           /* sha1 digest */
+    p += 20;
+    p = put32(p, extra ? 37 : 33); /* event size */
+    memcpy(p, "Spec ID Event03", 16);
+    p += 16;
+    p = put32(p, 0);            /* platform class */
+    *p++ = 0; *p++ = 2; *p++ = 0; *p++ = 2; /* 2.0, errata 0, uintn 2 */
+    p = put32(p, extra ? 2 : 1); /* the algorithms */
+    p = put16(p, TPM_ALG_SHA256);
+    p = put16(p, 32);
+    if ( extra == WITH_SHA384 )
+    {
+        p = put16(p, TPM_ALG_SHA384);
+        p = put16(p, 48);
+    }
+    else if ( extra == WITH_SHA1 )
+    {
+        p = put16(p, TPM_ALG_SHA1);
+        p = put16(p, 20);
+    }
+    *p++ = 0;                   /* vendor info size */
+
+    p = put_record(p, 17, 0x8001, TPM_ALG_SHA256, 32, 0x11, 0);
+    p = put_record(p, 17, 0x8002, TPM_ALG_SHA256, 32, 0x22, 4);
+    p = put_record(p, 17, 0x8003, TPM_ALG_SHA256, 32, 0x33, 8);
+    p = put_record(p, 18, 0x8004, TPM_ALG_SHA256, 32, 0x44, 0);
+    p = put_record(p, 18, 0x8005, TPM_ALG_SHA256, 32, 0x55, 4);
+    if ( extra == WITH_SHA384 )
+        p = put_record(p, 17, 0x8006, TPM_ALG_SHA384, 48, 0x66, 0);
+    else if ( extra == WITH_SHA1 )
+        p = put_record2(p, 17, 0x8006, 0x66, 0);
+    return p - buf;
+}
+
+static struct tpm tpm20 = { .family = TPM20 };
+
+static int failures;
+
+#define CHECK(cond) do {                                             \
+    if ( !(cond) ) {                                                 \
+        printf("%s:%d: %s\n", __FILE__, __LINE__, #cond);            \
+        failures++;                                                  \
+    }                                                                \
+} while ( 0 )
+
+static void fresh_log(u32 size)
+{
+    nextends = 0;
+    slrt.t.size = sizeof(slrt);
+    slrt.log.hdr.tag = SLR_ENTRY_LOG_INFO;
+    slrt.log.hdr.size = sizeof(slrt.log);
+    slrt.log.format = SLR_DRTM_TPM20_LOG;
+    slrt.log.size = size;
+    slrt.log.addr = _u(log_region);
+    slrt.end.tag = SLR_ENTRY_END;
+    slrt.end.size = sizeof(slrt.end);
+    memset(log_region, 0xa5, sizeof(log_region));
+    CHECK(event_log_init(&tpm20) == 0);
+}
+
+/* The header as a reader parses it: the algorithm table and the vendor info */
+static struct {
+    u32 nalgs;
+    u16 alg[MAX_BANKS];
+    u16 size[MAX_BANKS];
+    txt_event_log_pointer2_1_element *el;
+    const u8 *records;
+} hdr;
+
+static void parse_header(void)
+{
+    const u8 *p = log_region + sizeof(tpm12_event_t);
+    u32 i;
+
+    CHECK(memcmp(p, "Spec ID Event03", 16) == 0);
+    p += sizeof(common_spec_id_ev_t);
+    memcpy(&hdr.nalgs, p, 4);
+    p += 4;
+    CHECK(hdr.nalgs >= 1 && hdr.nalgs <= MAX_BANKS);
+    for ( i = 0; i < hdr.nalgs && i < MAX_BANKS; i++ )
+    {
+        memcpy(&hdr.alg[i], p, 2);
+        memcpy(&hdr.size[i], p + 2, 2);
+        p += 4;
+    }
+    CHECK(*p == sizeof(*hdr.el));
+    hdr.el = (txt_event_log_pointer2_1_element *)(p + 1);
+    hdr.records = p + 1 + sizeof(*hdr.el);
+}
+
+/*
+ * The records after the header, parsed as a reader would: each carries
+ * the header's banks in its order, and for every bank the first digest
+ * byte and whether it is the placeholder.
+ */
+struct record {
+    u32 pcr, type;
+    u8 first[MAX_BANKS];
+    bool placeholder[MAX_BANKS];
+};
+
+static unsigned records(struct record *out, unsigned max)
+{
+    const u8 *p;
+    unsigned n = 0;
+
+    parse_header();
+    p = hdr.records;
+    while ( n < max )
+    {
+        u32 count, i, len;
+
+        memcpy(&out[n].pcr, p, 4);
+        memcpy(&out[n].type, p + 4, 4);
+        memcpy(&count, p + 8, 4);
+        if ( count == 0 )
+            break;
+        p += 12;
+        CHECK(count == hdr.nalgs);
+        for ( i = 0; i < count && i < MAX_BANKS; i++ )
+        {
+            u16 alg;
+            memcpy(&alg, p, 2);
+            CHECK(alg == hdr.alg[i]);
+            out[n].first[i] = p[2];
+            out[n].placeholder[i] = is_placeholder(p + 2, hdr.size[i]);
+            p += 2 + hdr.size[i];
+        }
+        memcpy(&len, p, 4);
+        p += 4 + len;
+        n++;
+    }
+    return n;
+}
+
+/* The PSP's record of @type carries (type & 0xf) * 0x11 in every byte */
+static u8 psp_byte(u32 type)
+{
+    return (type & 0xf) * 0x11;
+}
+
+int main(void)
+{
+    u8 buf[512], skinit_sha1[20], skinit_sha256[32];
+    u32 size, before;
+    struct record recs[16];
+    unsigned n;
+
+    sha1sum(skinit_sha1, skl_start, 16);
+    sha256sum(skinit_sha256, skl_start, 16);
+
+    /* A TPM with the two banks a discrete one ships with */
+    tpm_has(2, TPM_ALG_SHA1, TPM_ALG_SHA256);
+    fresh_log(sizeof(log_region));
+    n = records(recs, 16);
+    CHECK(hdr.nalgs == 2 && hdr.alg[0] == TPM_ALG_SHA1 && hdr.size[0] == 20);
+    CHECK(hdr.alg[1] == TPM_ALG_SHA256 && hdr.size[1] == 32);
+    CHECK(hdr.el->phys_addr == _u(log_region));
+    CHECK(hdr.el->allocated_event_container_size == sizeof(log_region));
+    CHECK(hdr.el->first_record_offset == 0);
+    /* The header event, the header with its two banks, then SKINIT's record */
+    CHECK(hdr.records == log_region + 32 + 24 + 4 + 8 + 1 + 20);
+    CHECK(hdr.el->next_record_offset == 32 + 24 + 4 + 8 + 1 + 20 + 72 + 6);
+    CHECK(n == 1);
+    CHECK(recs[0].pcr == 17 && recs[0].type == EV_TYPE_SLAUNCH);
+    CHECK(recs[0].first[0] == skinit_sha1[0] && !recs[0].placeholder[0]);
+    CHECK(recs[0].first[1] == skinit_sha256[0] && !recs[0].placeholder[1]);
+    /* Nothing to extend the placeholder into */
+    event_log_extend_placeholders(&tpm20, 17);
+    CHECK(nextends == 0);
+
+    /* The PSP's records land after SKINIT, without its SL_IMAGE one */
+    size = psp_log(buf, PLAIN);
+    before = hdr.el->next_record_offset;
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) == 0);
+    n = records(recs, 16);
+    CHECK(n == 5);
+    CHECK(recs[1].pcr == 17 && recs[1].type == 0x8002);
+    CHECK(recs[2].pcr == 17 && recs[2].type == 0x8003);
+    CHECK(recs[3].pcr == 18 && recs[3].type == 0x8004);
+    CHECK(recs[4].pcr == 18 && recs[4].type == 0x8005);
+    for ( n = 1; n < 5; n++ )
+    {
+        CHECK(recs[n].placeholder[0]);
+        CHECK(recs[n].first[1] == psp_byte(recs[n].type) && !recs[n].placeholder[1]);
+    }
+    /* Four records of 12 + 22 + 34 + 4 bytes, plus 4 + 8 + 0 + 4 of data */
+    CHECK(hdr.el->next_record_offset == before + 4 * 72 + 16);
+    /* And the SHA-1 bank extended with the placeholder for each */
+    CHECK(nextends == 4);
+    for ( n = 0; n < 4; n++ )
+    {
+        CHECK(extends[n].pcr == (n < 2 ? 17 : 18));
+        CHECK(extends[n].alg == TPM_ALG_SHA1 && extends[n].placeholder);
+    }
+
+    /* Nothing skipped when no type matches */
+    fresh_log(sizeof(log_region));
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0) == 0);
+    CHECK(records(recs, 16) == 6);
+    CHECK(nextends == 5);
+
+    /* A log cut short in a record stops before that record */
+    fresh_log(sizeof(log_region));
+    CHECK(event_log_append_tcg2(&tpm20, buf, size - 10, 0x8001) != 0);
+    CHECK(records(recs, 16) == 4);
+    CHECK(nextends == 3);
+
+    /* A log cut short in its header appends nothing */
+    fresh_log(sizeof(log_region));
+    CHECK(event_log_append_tcg2(&tpm20, buf, 40, 0x8001) != 0);
+    CHECK(records(recs, 16) == 1);
+
+    /* A header that is not Spec ID Event03 appends nothing */
+    fresh_log(sizeof(log_region));
+    buf[32 + 14] = '2';
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) != 0);
+    CHECK(records(recs, 16) == 1);
+    buf[32 + 14] = '3';
+
+    /*
+     * A record whose digest is of a bank this log lacks keeps its place
+     * with the placeholder in every bank, and each is extended.
+     */
+    fresh_log(sizeof(log_region));
+    size = psp_log(buf, WITH_SHA384);
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) == 0);
+    CHECK(records(recs, 16) == 6);
+    CHECK(recs[5].type == 0x8006 && recs[5].placeholder[0] && recs[5].placeholder[1]);
+    CHECK(nextends == 6);
+    CHECK(extends[4].alg == TPM_ALG_SHA1 && extends[5].alg == TPM_ALG_SHA256);
+    CHECK(extends[5].pcr == 17 && extends[5].placeholder);
+
+    /* A record carrying both banks needs no placeholder and no extend */
+    fresh_log(sizeof(log_region));
+    size = psp_log(buf, WITH_SHA1);
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) == 0);
+    CHECK(records(recs, 16) == 6);
+    CHECK(recs[5].first[0] == 0x66 && !recs[5].placeholder[0]);
+    CHECK(recs[5].first[1] == 0x66 && !recs[5].placeholder[1]);
+    CHECK(nextends == 4);
+
+    /* A digest of an algorithm the log's header does not size stops the copy */
+    fresh_log(sizeof(log_region));
+    size = psp_log(buf, PLAIN);
+    size = put_record(buf + size, 17, 0x8006, TPM_ALG_SHA384, 48, 0x66, 0) - buf;
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) != 0);
+    CHECK(records(recs, 16) == 5);
+    CHECK(nextends == 4);
+
+    /*
+     * A log region with room for two of the PSP's records after SKINIT,
+     * 76 and 80 bytes, stops where it is full, without extending for the
+     * third. After event_log_init() the next record offset is the bytes
+     * in use.
+     */
+    fresh_log(sizeof(log_region));
+    parse_header();
+    fresh_log(hdr.el->next_record_offset + 200);
+    size = psp_log(buf, PLAIN);
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) != 0);
+    CHECK(records(recs, 16) == 3);
+    CHECK(nextends == 2);
+
+    /* A TPM 1.2 log takes nothing */
+    {
+        struct tpm tpm12 = { .family = TPM12 };
+        fresh_log(sizeof(log_region));
+        CHECK(event_log_append_tcg2(&tpm12, buf, size, 0x8001) != 0);
+        CHECK(records(recs, 16) == 1);
+    }
+
+    /* A TPM with SHA-256 alone: one digest per record, nothing to place hold */
+    tpm_has(1, TPM_ALG_SHA256);
+    fresh_log(sizeof(log_region));
+    n = records(recs, 16);
+    CHECK(hdr.nalgs == 1 && hdr.alg[0] == TPM_ALG_SHA256);
+    CHECK(hdr.records == log_region + 32 + 24 + 4 + 4 + 1 + 20);
+    CHECK(n == 1 && recs[0].first[0] == skinit_sha256[0] && !recs[0].placeholder[0]);
+    event_log_extend_placeholders(&tpm20, 17);
+    CHECK(nextends == 0);
+    before = hdr.el->next_record_offset;
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) == 0);
+    n = records(recs, 16);
+    CHECK(n == 5);
+    for ( n = 1; n < 5; n++ )
+        CHECK(recs[n].first[0] == psp_byte(recs[n].type) && !recs[n].placeholder[0]);
+    /* Four records of 12 + 34 + 4 bytes, plus 16 of data */
+    CHECK(hdr.el->next_record_offset == before + 4 * 50 + 16);
+    CHECK(nextends == 0);
+
+    /*
+     * A TPM with SHA-384 as well, in its own order: the SKL's records get
+     * the placeholder there, the PSP's in SHA-1 too, each extended.
+     */
+    tpm_has(3, TPM_ALG_SHA256, TPM_ALG_SHA1, TPM_ALG_SHA384);
+    fresh_log(sizeof(log_region));
+    n = records(recs, 16);
+    CHECK(hdr.nalgs == 3 && hdr.alg[0] == TPM_ALG_SHA256 && hdr.alg[1] == TPM_ALG_SHA1);
+    CHECK(hdr.alg[2] == TPM_ALG_SHA384 && hdr.size[2] == 48);
+    CHECK(n == 1);
+    CHECK(recs[0].first[0] == skinit_sha256[0] && !recs[0].placeholder[0]);
+    CHECK(recs[0].first[1] == skinit_sha1[0] && !recs[0].placeholder[1]);
+    CHECK(recs[0].placeholder[2]);
+    event_log_extend_placeholders(&tpm20, 17);
+    CHECK(nextends == 1);
+    CHECK(extends[0].pcr == 17 && extends[0].alg == TPM_ALG_SHA384 && extends[0].placeholder);
+    nextends = 0;
+    before = hdr.el->next_record_offset;
+    CHECK(event_log_append_tcg2(&tpm20, buf, size, 0x8001) == 0);
+    n = records(recs, 16);
+    CHECK(n == 5);
+    for ( n = 1; n < 5; n++ )
+    {
+        CHECK(recs[n].first[0] == psp_byte(recs[n].type) && !recs[n].placeholder[0]);
+        CHECK(recs[n].placeholder[1] && recs[n].placeholder[2]);
+    }
+    /* Four records of 12 + 34 + 22 + 50 + 4 bytes, plus 16 of data */
+    CHECK(hdr.el->next_record_offset == before + 4 * 122 + 16);
+    CHECK(nextends == 8);
+    for ( n = 0; n < 8; n++ )
+    {
+        CHECK(extends[n].pcr == (n < 4 ? 17 : 18));
+        CHECK(extends[n].alg == (n % 2 ? TPM_ALG_SHA384 : TPM_ALG_SHA1));
+        CHECK(extends[n].placeholder);
+    }
+
+    /* A bank of an algorithm the SKL cannot size is left out */
+    tpm_has(2, 0x99, TPM_ALG_SHA256);
+    fresh_log(sizeof(log_region));
+    records(recs, 16);
+    CHECK(hdr.nalgs == 1 && hdr.alg[0] == TPM_ALG_SHA256);
+
+    /* A TPM that does not answer is taken for the two-bank one */
+    tpm_banks_rc = -1;
+    fresh_log(sizeof(log_region));
+    records(recs, 16);
+    CHECK(hdr.nalgs == 2 && hdr.alg[0] == TPM_ALG_SHA1 && hdr.alg[1] == TPM_ALG_SHA256);
+
+    /* A region too small for the header and two bare records is refused */
+    tpm_has(2, TPM_ALG_SHA1, TPM_ALG_SHA256);
+    nextends = 0;
+    slrt.log.size = 32 + 57 + 2 * 72 - 1;
+    CHECK(event_log_init(&tpm20) != 0);
+    slrt.log.size = 32 + 57 + 2 * 72;
+    CHECK(event_log_init(&tpm20) == 0);
+
+    if ( failures )
+    {
+        printf("%d failures\n", failures);
+        return 1;
+    }
+    printf("ok\n");
+    return 0;
+}

     print_dlme_hash(dl_info);
 
     if (!drtm_extend_ossl_digest((u64)dl_info->dlme_base, dl_info->dlme_size)) {
@@ -574,8 +579,27 @@ static asm_return_t amdsl_launch()
     print("AMDSL: PCRs after DRTM_CMD_EXTEND_OSSL_DIGEST\n");
     print_pcrs_at(tpm, 2);

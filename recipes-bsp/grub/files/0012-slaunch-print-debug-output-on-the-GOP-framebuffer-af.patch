From e18e78ad02632d6230543a7097295d637a5f1740 Mon Sep 17 00:00:00 2001
From: iwanicki92 <iwanicki92@gmail.com>
Date: Sat, 26 Sep 2026 16:59:18 +0200
Subject: [PATCH] slaunch: print debug output on the GOP framebuffer after EBS

Once the boot services are gone the EFI console prints nothing, so on a
platform without a serial port nothing shows where a launch stops. With
"slaunch" debug on, remember the GOP at the slaunch command and, when
dl_entry runs after the boot services exited, register a small text
terminal that draws into the framebuffer. dl_entry reads the GOP mode
again first, as the OS may have changed it.

On AMD the SLRT also gets a debug-only entry describing the framebuffer
and the line GRUB stopped at, so the SKL can print below it. It is only
added with "slaunch" debug on, and it is not in the SLRT specification.

The glyphs are the ASCII part of the X11 misc-fixed 8x16 font, which is
public domain.

Upstream-Status: Inappropriate [debug]
Signed-off-by: iwanicki92 <iwanicki92@gmail.com>
---
 grub-core/Makefile.core.def        |   2 +
 grub-core/loader/slaunch/dlstub.c  |  10 +
 grub-core/loader/slaunch/fb.c      | 463 +++++++++++++++++++++++++++++
 grub-core/loader/slaunch/skl.c     |   3 +
 grub-core/loader/slaunch/slaunch.c |   2 +
 include/grub/slaunch.h             |  14 +
 include/grub/slr_table.h           |  19 ++
 7 files changed, 513 insertions(+)
 create mode 100644 grub-core/loader/slaunch/fb.c

diff --git a/grub-core/Makefile.core.def b/grub-core/Makefile.core.def
index a7fa07fa7..70127010a 100644
--- a/grub-core/Makefile.core.def
+++ b/grub-core/Makefile.core.def
@@ -1905,6 +1905,8 @@ module = {
   x86 = loader/efi/dltrampoline.S;
   i386_efi = loader/slaunch/x86_efi_linux.c;
   x86_64_efi = loader/slaunch/x86_efi_linux.c;
+  i386_efi = loader/slaunch/fb.c;
+  x86_64_efi = loader/slaunch/fb.c;
   enable = x86;
 };
 
diff --git a/grub-core/loader/slaunch/dlstub.c b/grub-core/loader/slaunch/dlstub.c
index 309d0e8f3..58160fdd1 100644
--- a/grub-core/loader/slaunch/dlstub.c
+++ b/grub-core/loader/slaunch/dlstub.c
@@ -55,6 +55,10 @@ void dl_entry (grub_uint64_t dl_ctx)
    */
   if (slparams->boot_type == GRUB_SL_BOOT_TYPE_EFI)
     grub_efi_is_finished = 1;
+
+  /* Without the EFI console, debug output goes to the framebuffer */
+  if (grub_efi_is_finished)
+    grub_slaunch_fb_start ();
 #endif
 
   state.edi = slparams->platform_type;
@@ -122,6 +126,12 @@ void dl_entry (grub_uint64_t dl_ctx)
       goto fail;
     }
 
+  grub_dprintf ("slaunch", "dl_entry: launching, DCE at 0x%llx\n",
+                (unsigned long long) slparams->dce_base);
+
+  if (slparams->platform_type == SLP_AMD_SKINIT)
+    grub_slaunch_fb_fill_slrt (slparams);
+
   if (slparams->boot_type == GRUB_SL_BOOT_TYPE_LINUX || slparams->boot_type == GRUB_SL_BOOT_TYPE_MB2)
     {
       if (slparams->platform_type == SLP_INTEL_TXT)

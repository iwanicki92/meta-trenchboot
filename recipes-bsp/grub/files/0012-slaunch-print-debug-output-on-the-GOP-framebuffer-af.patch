+  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x3c, 0x42,
+  0x40, 0x30, 0x0c, 0x02, 0x42, 0x3c, 0x00, 0x00,  /* 's' */
+  0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10, 0x7c,
+  0x10, 0x10, 0x10, 0x10, 0x10, 0x0c, 0x00, 0x00,  /* 't' */
+  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x42, 0x42,
+  0x42, 0x42, 0x42, 0x42, 0x46, 0x3a, 0x00, 0x00,  /* 'u' */
+  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x42, 0x42,
+  0x42, 0x24, 0x24, 0x24, 0x18, 0x18, 0x00, 0x00,  /* 'v' */
+  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x41, 0x49,
+  0x49, 0x49, 0x49, 0x49, 0x49, 0x36, 0x00, 0x00,  /* 'w' */

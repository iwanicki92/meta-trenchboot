+};
+
+static grub_guid_t gop_guid = GRUB_EFI_GOP_GUID;
+static struct grub_efi_gop *gop;
+
+static struct
+{
+  grub_uint64_t base;
+  grub_uint64_t size;
+  grub_uint32_t width;
+  grub_uint32_t height;
+  grub_uint32_t stride;		/* In bytes, 4 bytes per pixel. */
+  grub_uint32_t white;
+  grub_uint32_t scale;
+  grub_uint32_t x;		/* Cursor, in pixels. */
+  grub_uint32_t y;
+} fb;
+
+/*
+ * Reads the current GOP mode. After the boot services exit this reads
+ * firmware memory nobody has reused yet, which is good enough for debug.
+ */
+static int
+fb_read_mode (void)
+{
+  struct grub_efi_gop_mode *mode;
+  struct grub_efi_gop_mode_info *info;
+
+  fb.base = 0;
+
+  if (gop == NULL || (mode = gop->mode) == NULL || (info = mode->info) == NULL)
+    return 0;
+
+  if (info->pixel_format != GRUB_EFI_GOT_RGBA8
+      && info->pixel_format != GRUB_EFI_GOT_BGRA8)
+    return 0;
+
+  if (mode->fb_base == 0 || info->width == 0 || info->height == 0
+      || info->pixels_per_scanline < info->width
+      || (grub_uint64_t) info->pixels_per_scanline * 4 * info->height > mode->fb_size)
+    return 0;
+
+  fb.base = mode->fb_base;
+  fb.size = mode->fb_size;
+  fb.width = info->width;
+  fb.height = info->height;
+  fb.stride = info->pixels_per_scanline * 4;
+  fb.white = 0x00ffffff;
+  fb.scale = fb.width / 1280 ? : 1;
+
+  if (fb.y >= fb.height)
+    fb.y = 0;
+
+  return 1;
+}
+
+static grub_uint32_t *
+fb_line (grub_uint32_t y)
+{
+  return (grub_uint32_t *) (grub_addr_t) (fb.base + (grub_uint64_t) y * fb.stride);
+}
+
+static void
+fb_clear (grub_uint32_t y, grub_uint32_t lines)
+{
+  for (; lines && y < fb.height; y++, lines--)
+    grub_memset (fb_line (y), 0, fb.width * 4);
+}
+
+/* Starts a new text line and clears the one after it, which marks the end. */
+static void
+fb_newline (void)
+{
+  grub_uint32_t line = FONT_HEIGHT * fb.scale;
+
+  fb.x = 0;
+  fb.y += line;
+  if (fb.y + line > fb.height)
+    fb.y = 0;
+  fb_clear (fb.y, 2 * line);
+}
+
+static void
+fb_draw (grub_uint32_t c)
+{
+  const grub_uint8_t *glyph;
+  grub_uint32_t row, col;
+
+  if (c < FONT_FIRST || c > FONT_LAST)
+    c = '?';
+  glyph = &font[(c - FONT_FIRST) * FONT_HEIGHT];
+
+  if (fb.x + FONT_WIDTH * fb.scale > fb.width)
+    fb_newline ();
+
+  for (row = 0; row < FONT_HEIGHT * fb.scale; row++)
+    {
+      volatile grub_uint32_t *p = fb_line (fb.y + row) + fb.x;
+      grub_uint8_t bits = glyph[row / fb.scale];
+
+      for (col = 0; col < FONT_WIDTH * fb.scale; col++)
+	p[col] = (bits & (0x80 >> (col / fb.scale))) ? fb.white : 0;
+    }
+
+  fb.x += FONT_WIDTH * fb.scale;
+}
+
+static void
+fb_putchar (struct grub_term_output *term __attribute__ ((unused)),
+	    const struct grub_unicode_glyph *c)
+{
+  switch (c->base)
+    {
+    case '\n':
+      fb_newline ();
+      break;
+    case '\r':
+      fb.x = 0;
+      break;
+    case '\b':
+      if (fb.x >= FONT_WIDTH * fb.scale)
+	fb.x -= FONT_WIDTH * fb.scale;
+      break;
+    default:
+      fb_draw (c->base);
+    }
+}
+
+static struct grub_term_coordinate
+fb_getwh (struct grub_term_output *term __attribute__ ((unused)))
+{
+  return (struct grub_term_coordinate) { fb.width / (FONT_WIDTH * fb.scale),
+					 fb.height / (FONT_HEIGHT * fb.scale) };
+}
+
+static struct grub_term_coordinate
+fb_getxy (struct grub_term_output *term __attribute__ ((unused)))
+{
+  return (struct grub_term_coordinate) { fb.x / (FONT_WIDTH * fb.scale),
+					 fb.y / (FONT_HEIGHT * fb.scale) };
+}
+
+static void
+fb_gotoxy (struct grub_term_output *term __attribute__ ((unused)),
+	   struct grub_term_coordinate pos)
+{
+  struct grub_term_coordinate wh = fb_getwh (NULL);
+
+  if (pos.x < wh.x && pos.y < wh.y)
+    {
+      fb.x = pos.x * FONT_WIDTH * fb.scale;
+      fb.y = pos.y * FONT_HEIGHT * fb.scale;
+    }
+}
+
+static void
+fb_cls (struct grub_term_output *term __attribute__ ((unused)))
+{
+  fb_clear (0, fb.height);
+  fb.x = fb.y = 0;
+}
+
+static struct grub_term_output fb_term =
+  {
+    .name = "slaunch_fb",
+    .putchar = fb_putchar,
+    .getwh = fb_getwh,
+    .getxy = fb_getxy,
+    .gotoxy = fb_gotoxy,
+    .cls = fb_cls,
+    .flags = GRUB_TERM_CODE_TYPE_ASCII,
+  };
+
+void
+grub_slaunch_fb_capture (void)
+{
+  if (grub_debug_enabled ("slaunch"))
+    gop = grub_efi_locate_protocol (&gop_guid, NULL);
+}
+
+void
+grub_slaunch_fb_start (void)
+{
+  if (fb_term.next || fb_term.prev || !fb_read_mode ())
+    return;
+
+  fb_cls (NULL);
+  grub_term_register_output_active ("slaunch_fb", &fb_term);
+  grub_dprintf ("slaunch", "framebuffer console at 0x%llx, %ux%u\n",
+		(unsigned long long) fb.base, fb.width, fb.height);
+}
+
+void
+grub_slaunch_fb_add_slrt (struct grub_slr_table *slrt)
+{
+  struct grub_slr_entry_debug_fb entry = {
+    .hdr.tag = GRUB_SLR_ENTRY_DEBUG_FB,
+    .hdr.size = sizeof (entry),
+  };
+
+  if (gop != NULL)
+    grub_slr_add_entry (slrt, &entry.hdr);
+}
+
+void
+grub_slaunch_fb_fill_slrt (struct grub_slaunch_params *slparams)
+{
+  struct grub_slr_entry_debug_fb *entry;
+
+  entry = grub_slr_next_entry_by_tag (slparams->slr_table_mem,
+				      NULL, GRUB_SLR_ENTRY_DEBUG_FB);
+  if (entry == NULL)
+    return;
+
+  /* The SKL takes base 0 as no framebuffer. */
+  if (!fb_read_mode ())
+    return;
+
+  /* The SKL refuses it and says so on serial only. */
+  if (fb.base + fb.size > 0x100000000ULL)
+    grub_dprintf ("slaunch", "framebuffer ends above 4 GiB at 0x%llx, "
+		  "the SKL will not print here\n",
+		  (unsigned long long) (fb.base + fb.size));
+
+  entry->base = fb.base;
+  entry->size = fb.size;
+  entry->width = fb.width;
+  entry->height = fb.height;
+  entry->stride = fb.stride;
+  entry->white = fb.white;
+  entry->next_y = fb.y;
+}
